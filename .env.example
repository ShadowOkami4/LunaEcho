NODE_ENV=development
LOG_LEVEL=debug
DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_APPLICATION_ID=replace-with-your-application-id
# DISCORD_DEVELOPMENT_GUILD_ID=replace-with-a-test-server-id
# DISCORD_SMOKE_TEST_CHANNEL_ID=replace-with-a-test-channel-id
LUNA_RUNTIME_MODE=self-hosted
# Matches the PostgreSQL service in docker-compose.yml.
DATABASE_URL=postgresql://lunaecho:lunaecho@localhost:5432/lunaecho

# Music plays through a Lavalink node (see docs/music.md). Leave both unset to disable music.
# LAVALINK_URL=localhost:2333
# LAVALINK_PASSWORD=replace-with-the-lavalink-password
# MUSIC_SEARCH_SOURCES=ytsearch,scsearch
# YT_CIPHER_TOKEN=password-shared-by-lavalink-and-yt-cipher

# Optional: Twitch live alerts (create an app on dev.twitch.tv). YouTube alerts need no keys.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# Dashboard (see docs/dashboard.md).
# DASHBOARD_URL=http://localhost:3000
# DISCORD_CLIENT_SECRET=from-the-developer-portal-oauth2-page
# SESSION_SECRET=at-least-32-random-characters

# Live load tests on the test server only (see docs/testing.md). Leave unset in production.
# LOAD_TEST_BOT_IDS=helper-bot-user-id,another-helper-bot-user-id
# LOAD_BOT_TOKENS=helper-bot-token,another-helper-bot-token
# LIVE_LOBBY_CHANNEL_ID=voice-room-lobby-channel-id
