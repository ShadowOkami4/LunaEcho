{
  "name": "@lunaecho/db",
  "version": "0.1.0",
  "private": true,
  "description": "LunaEcho PostgreSQL schema, migrations, and database connection.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --conditions=development src/scripts/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lunaecho/core": "0.1.0",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
