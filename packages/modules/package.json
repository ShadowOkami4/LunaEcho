{
  "name": "@lunaecho/modules",
  "version": "0.1.0",
  "private": true,
  "description": "Discord-independent LunaEcho module logic and storage, shared by the bot and the dashboard.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lunaecho/core": "0.1.0",
    "@lunaecho/db": "0.1.0",
    "drizzle-orm": "0.45.3",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
