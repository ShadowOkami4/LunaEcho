# Secrets never enter an image; deployments pass them at run time.
.env
.env.*
!.env.example
testbot/

# Rebuilt inside the image.
node_modules/
**/node_modules/
**/dist/
**/.next/
**/*.tsbuildinfo
**/next-env.d.ts

# Not needed to build or run.
.git/
stress-results/
coverage/
data/
lavalink/plugins/
*.log
