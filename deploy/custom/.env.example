# LunaEcho Custom on the server. Copy to .env next to docker-compose.yml and chmod 600 it.
# Random values, for example: openssl rand -hex 24

# Superuser of the Custom database server (customer databases live there).
CUSTOM_POSTGRES_PASSWORD=
# The Cloud project's POSTGRES_PASSWORD: the orchestrator reads the custom_bots table there.
CLOUD_POSTGRES_PASSWORD=
# Shared by Lavalink, yt-cipher, and the Custom bots.
LAVALINK_PASSWORD=
YT_CIPHER_TOKEN=

# The token key is a file, not a variable: ../lunaecho-platform/token.key
# (openssl rand -base64 32 > token.key; chmod 600 token.key)
