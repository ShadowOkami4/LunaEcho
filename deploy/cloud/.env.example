# LunaEcho Cloud on the server. Copy to .env next to docker-compose.yml and chmod 600 it.
# DATABASE_URL, LUNA_RUNTIME_MODE, and NODE_ENV are set by docker-compose.yml.

# The official LunaEcho application (Discord Developer Portal).
DISCORD_APPLICATION_ID=
DISCORD_TOKEN=
DISCORD_CLIENT_SECRET=

# The public dashboard address; the Developer Portal needs
# <DASHBOARD_URL>/api/auth/callback as an OAuth2 redirect.
DASHBOARD_URL=https://lunaecho.shadowokami.com

# Random secrets, for example: openssl rand -base64 48
SESSION_SECRET=
POSTGRES_PASSWORD=

LOG_LEVEL=info

# Optional: the private billing service for paid Custom slots (see docs/deployment.md).
# BILLING_URL=https://lunaecho.shadowokami.com/billing/
# BILLING_HANDOFF_SECRET=
